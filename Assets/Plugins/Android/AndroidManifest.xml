<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — Z-Anatomy Android App
  Place this file at: Assets/Plugins/Android/AndroidManifest.xml

  Key settings explained:
    android:largeHeap="true"        — Essential for loading thousands of 3D anatomy structures
    android:hardwareAccelerated     — GPU rendering for smooth 3D viewport
    android:configChanges           — Prevents activity restart on orientation change
    WAKE_LOCK                       — Keeps screen on during study sessions
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.zanatomy.android"
    android:versionCode="1"
    android:versionName="1.0.0">

    <!-- ===== SDK Versions ===== -->
    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <!-- ===== Permissions ===== -->

    <!-- Internet: needed for Firebase analytics / future content updates -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Network state: for detecting offline mode gracefully -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Vibration: used for haptic feedback on structure selection -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Wake lock: keeps screen on during anatomy study -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ===== Feature Requirements ===== -->

    <!-- Require OpenGL ES 3.0 for proper shader support -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- Touchscreen required -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <!-- Multitouch preferred (for pinch-to-zoom, rotate) -->
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="false" />

    <!-- ===== Application ===== -->
    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:allowBackup="false">

        <!-- ===== Unity Player Activity ===== -->
        <activity
            android:name="com.unity3d.player.UnityPlayerActivity"
            android:label="@string/app_name"
            android:screenOrientation="fullSensor"
            android:launchMode="singleTask"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            android:hardwareAccelerated="true"
            android:exported="true">

            <!-- Launcher intent filter -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link support for future sharing of anatomy views -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zanatomy" />
            </intent-filter>

        </activity>

        <!-- Firebase services (already in Mobile-Version) -->
        <!-- These are auto-generated by Firebase plugin; kept here for reference -->

    </application>

</manifest>
